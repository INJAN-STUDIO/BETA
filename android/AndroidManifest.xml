<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:amazon="http://schemas.amazon.com/apk/res/android">

<!-- v4.9: lets the "Take a photo" and "Record a video" buttons open the phone's camera from inside the app -->
<uses-permission android:name="android.permission.CAMERA" />
<uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-feature android:name="android.hardware.camera" android:required="false" />
<!-- v5.0: reply alerts through Firebase Cloud Messaging. Android 13 and newer ask for this permission; older Android
     (like the Honor 8X) simply allows notifications. -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<queries>
  <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
  <intent><action android:name="android.media.action.VIDEO_CAPTURE" /></intent>
  <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="*/*" /></intent>
</queries>

<application  >
  <!-- v5.0: alerts that arrive while the app is closed use the "Replies" channel the app creates (see fcm_push.py) -->
  <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="beta_replies" />
</application>

</manifest>
